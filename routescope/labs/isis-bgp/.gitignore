# Files the routers write next to their configuration. The lab's git
# history replaces their backups and rollbacks.
*.sav
*.tmp
*.broken
*.kernel
*.rollback.*
# routescope recordings and scenario reports
recordings/
# what nodes write in a bind-mounted run folder; the folder itself stays,
# so a .gitkeep is kept in it
*-run/*
!*-run/.gitkeep
# what containerlab writes when it deploys the lab, and its backup of
# the topology file
clab-*/
.*.clab.yml.bak
